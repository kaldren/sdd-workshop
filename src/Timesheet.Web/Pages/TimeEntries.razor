@page "/time-entries"
@using System.ComponentModel.DataAnnotations
@using System.Net
@using System.Text.Json
@using Timesheet.Shared
@inject HttpClient Http

<PageTitle>Time entries</PageTitle>

<h1>Time entries</h1>
<p>Record the time you spend on a project and review your entries.</p>

@if (!string.IsNullOrEmpty(actionError))
{
    <div class="alert alert-danger" role="alert">@actionError</div>
}

<section class="card shadow-sm mb-4" aria-labelledby="create-entry-heading">
    <div class="card-body">
        <h2 id="create-entry-heading" class="card-title">Add a time entry</h2>

        @if (!string.IsNullOrEmpty(submitError))
        {
            <div class="alert alert-danger" role="alert">@submitError</div>
        }

        <EditForm EditContext="@editContext" OnValidSubmit="CreateEntryAsync">
            <DataAnnotationsValidator />

            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label for="entry-date" class="form-label">Date *</label>
                    <InputDate id="entry-date" class="form-control" @bind-Value="form.Date" />
                    <ValidationMessage For="@(() => form.Date)" class="invalid-feedback d-block" />
                </div>
                <div class="col-12 col-md-6">
                    <label for="entry-project" class="form-label">Project *</label>
                    <InputText id="entry-project" class="form-control" @bind-Value="form.Project" />
                    <ValidationMessage For="@(() => form.Project)" class="invalid-feedback d-block" />
                </div>
                <div class="col-12 col-md-6">
                    <label for="entry-hours" class="form-label">Hours *</label>
                    <InputNumber id="entry-hours" class="form-control" @bind-Value="form.Hours" min="0" max="24" step="any" />
                    <ValidationMessage For="@(() => form.Hours)" class="invalid-feedback d-block" />
                </div>
                <div class="col-12">
                    <label for="entry-description" class="form-label">Description</label>
                    <InputTextArea id="entry-description" class="form-control" @bind-Value="form.Description" />
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary time-entry-submit" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Add time entry</span>
                    }
                </button>
            </div>
        </EditForm>
    </div>
</section>

<section aria-labelledby="entries-heading">
    <h2 id="entries-heading">Recorded entries</h2>

    @if (isLoading)
    {
        <div class="d-flex align-items-center gap-2" role="status">
            <span class="spinner-border text-primary" aria-hidden="true"></span>
            <span>Loading time entries...</span>
        </div>
    }
    else if (!string.IsNullOrEmpty(loadError))
    {
        <div class="alert alert-danger" role="alert">@loadError</div>
    }
    else if (entries is { Count: 0 })
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <p class="mb-0">No time entries yet. Use the form above to add your first entry.</p>
            </div>
        </div>
    }
    else if (entries is not null)
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Date</th>
                            <th scope="col">Project</th>
                            <th scope="col" class="text-end">Hours</th>
                            <th scope="col">Description</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in entries)
                        {
                            <tr>
                                <td class="tabular-numbers">@entry.Date.ToString("yyyy-MM-dd")</td>
                                <td>@entry.Project</td>
                                <td class="text-end tabular-numbers">@entry.Hours.ToString("0.##")</td>
                                <td>@entry.Description</td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary"
                                                @onclick="() => OpenEditModal(entry)">
                                            Edit
                                        </button>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                @onclick="() => OpenDeleteModal(entry)">
                                            Delete
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</section>

@if (isEditModalOpen && editForm is not null && editEditContext is not null)
{
    <div class="modal-backdrop fade show" @onclick="CancelEdit"></div>
    <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="edit-entry-heading" @onclick="CancelEdit">
        <div class="modal-dialog modal-dialog-centered" role="document" @onclick:stopPropagation="true">
            <div class="modal-content">
                <EditForm EditContext="@editEditContext" OnValidSubmit="SaveEditAsync">
                    <DataAnnotationsValidator />
                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="edit-entry-heading">Edit time entry</h2>
                        <button type="button" class="btn-close" aria-label="Close" @onclick="CancelEdit"></button>
                    </div>
                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(actionError))
                        {
                            <div class="alert alert-danger" role="alert">@actionError</div>
                        }
                        @if (!string.IsNullOrEmpty(editError))
                        {
                            <div class="alert alert-danger" role="alert">@editError</div>
                        }

                        <div class="row g-3">
                            <div class="col-12">
                                <label for="edit-entry-date" class="form-label">Date *</label>
                                <InputDate id="edit-entry-date" class="form-control" @bind-Value="editForm.Date" />
                                <ValidationMessage For="@(() => editForm.Date)" class="invalid-feedback d-block" />
                            </div>
                            <div class="col-12">
                                <label for="edit-entry-project" class="form-label">Project *</label>
                                <InputText id="edit-entry-project" class="form-control" @bind-Value="editForm.Project" />
                                <ValidationMessage For="@(() => editForm.Project)" class="invalid-feedback d-block" />
                            </div>
                            <div class="col-12">
                                <label for="edit-entry-hours" class="form-label">Hours *</label>
                                <InputNumber id="edit-entry-hours" class="form-control" @bind-Value="editForm.Hours" min="0" max="24" step="any" />
                                <ValidationMessage For="@(() => editForm.Hours)" class="invalid-feedback d-block" />
                            </div>
                            <div class="col-12">
                                <label for="edit-entry-description" class="form-label">Description</label>
                                <InputTextArea id="edit-entry-description" class="form-control" @bind-Value="editForm.Description" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-primary" @onclick="CancelEdit" disabled="@isUpdating">Cancel</button>
                        <button type="submit" class="btn btn-primary" disabled="@isUpdating">
                            @if (isUpdating)
                            {
                                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <span>Save changes</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (isDeleteModalOpen && deleteTarget is not null)
{
    <div class="modal-backdrop fade show" @onclick="CancelDelete"></div>
    <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="delete-entry-heading" @onclick="CancelDelete">
        <div class="modal-dialog modal-dialog-centered" role="document" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="delete-entry-heading">Delete time entry</h2>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(actionError))
                    {
                        <div class="alert alert-danger" role="alert">@actionError</div>
                    }
                    <p class="mb-0">Are you sure you want to delete the time entry for @deleteTarget.Project on @deleteTarget.Date.ToString("yyyy-MM-dd")?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-primary" @onclick="CancelDelete" disabled="@isDeleting">Don't do it!</button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteEntryAsync" disabled="@isDeleting">
                        @if (isDeleting)
                        {
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        }
                        <span>Yeah, I'm sure!</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<TimeEntryResponse>? entries;
    private TimeEntryForm form = new();
    private EditContext editContext = default!;
    private ValidationMessageStore serverValidationMessages = default!;
    private TimeEntryResponse? editTarget;
    private TimeEntryForm? editForm;
    private EditContext? editEditContext;
    private ValidationMessageStore? editServerValidationMessages;
    private TimeEntryResponse? deleteTarget;
    private bool isLoading = true;
    private bool isSubmitting;
    private bool isEditModalOpen;
    private bool isDeleteModalOpen;
    private bool isUpdating;
    private bool isDeleting;
    private string? loadError;
    private string? submitError;
    private string? editError;
    private string? actionError;

    protected override async Task OnInitializedAsync()
    {
        SetupEditContext();
        await LoadEntriesAsync();
    }

    private async Task LoadEntriesAsync()
    {
        isLoading = true;
        loadError = null;

        try
        {
            entries = await Http.GetFromJsonAsync<List<TimeEntryResponse>>("api/time-entries");
            entries ??= [];
        }
        catch (HttpRequestException)
        {
            loadError = "Time entries could not be loaded. Please try again.";
        }
        catch (JsonException)
        {
            loadError = "The time entries response could not be read. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CreateEntryAsync()
    {
        isSubmitting = true;
        submitError = null;
        serverValidationMessages.Clear();
        editContext.NotifyValidationStateChanged();

        try
        {
            var request = new CreateTimeEntryRequest(
                form.Date,
                string.IsNullOrWhiteSpace(form.Project) ? null : form.Project.Trim(),
                form.Hours,
                string.IsNullOrWhiteSpace(form.Description) ? null : form.Description.Trim());

            using var response = await Http.PostAsJsonAsync("api/time-entries", request);
            if (response.StatusCode == HttpStatusCode.BadRequest)
            {
                await ReadValidationErrorsAsync(response, editContext, form, error => submitError = error, serverValidationMessages);
                return;
            }

            response.EnsureSuccessStatusCode();
            var createdEntry = await response.Content.ReadFromJsonAsync<TimeEntryResponse>()
                ?? throw new JsonException("The created time entry response was empty.");

            entries ??= [];
            entries.Add(createdEntry);
            entries = entries.OrderBy(entry => entry.Date).ThenBy(entry => entry.Id).ToList();
            loadError = null;
            form = new TimeEntryForm();
            SetupEditContext();
        }
        catch (HttpRequestException)
        {
            submitError = "The time entry could not be saved. Please try again.";
        }
        catch (JsonException)
        {
            submitError = "The server response could not be read. Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task ReadValidationErrorsAsync(
        HttpResponseMessage response,
        EditContext targetContext,
        TimeEntryForm targetForm,
        Action<string> setError,
        ValidationMessageStore targetValidationMessages)
    {
        try
        {
            using var document = await JsonDocument.ParseAsync(
                await response.Content.ReadAsStreamAsync());

            if (!document.RootElement.TryGetProperty("errors", out var errors)
                || errors.ValueKind != JsonValueKind.Object)
            {
                setError("The time entry was rejected. Please check the values and try again.");
                return;
            }

            var foundFieldError = false;
            foreach (var fieldError in errors.EnumerateObject())
            {
                var field = fieldError.Name.ToLowerInvariant() switch
                {
                    "date" => nameof(TimeEntryForm.Date),
                    "project" => nameof(TimeEntryForm.Project),
                    "hours" => nameof(TimeEntryForm.Hours),
                    _ => null
                };

                if (field is null || fieldError.Value.ValueKind != JsonValueKind.Array)
                {
                    continue;
                }

                foreach (var message in fieldError.Value.EnumerateArray())
                {
                    if (message.ValueKind == JsonValueKind.String && message.GetString() is { } text)
                    {
                        targetValidationMessages.Add(new FieldIdentifier(targetForm, field), text);
                        foundFieldError = true;
                    }
                }
            }

            if (!foundFieldError)
            {
                setError("The time entry was rejected. Please check the values and try again.");
            }

            targetContext.NotifyValidationStateChanged();
        }
        catch (JsonException)
        {
            setError("The time entry was rejected. Please check the values and try again.");
        }
    }

    private void OpenEditModal(TimeEntryResponse entry)
    {
        actionError = null;
        editTarget = entry;
        editForm = new TimeEntryForm
        {
            Date = entry.Date,
            Project = entry.Project,
            Hours = entry.Hours,
            Description = entry.Description
        };
        editEditContext = new EditContext(editForm);
        editServerValidationMessages = new ValidationMessageStore(editEditContext);
        editEditContext.OnFieldChanged += ClearEditServerValidationForField;
        editError = null;
        isEditModalOpen = true;
    }

    private async Task SaveEditAsync()
    {
        if (editTarget is null || editForm is null || editEditContext is null || editServerValidationMessages is null)
        {
            return;
        }

        isUpdating = true;
        actionError = null;
        editError = null;
        editServerValidationMessages.Clear();
        editEditContext.NotifyValidationStateChanged();

        try
        {
            var request = new UpdateTimeEntryRequest(
                editForm.Date,
                string.IsNullOrWhiteSpace(editForm.Project) ? null : editForm.Project.Trim(),
                editForm.Hours,
                string.IsNullOrWhiteSpace(editForm.Description) ? null : editForm.Description.Trim());

            using var response = await Http.PutAsJsonAsync($"api/time-entries/{editTarget.Id}", request);
            if (response.StatusCode == HttpStatusCode.BadRequest)
            {
                await ReadValidationErrorsAsync(
                    response,
                    editEditContext,
                    editForm,
                    error => editError = error,
                    editServerValidationMessages);
                return;
            }

            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                actionError = "This time entry no longer exists. Refresh the page and try again.";
                return;
            }

            response.EnsureSuccessStatusCode();
            var updatedEntry = await response.Content.ReadFromJsonAsync<TimeEntryResponse>()
                ?? throw new JsonException("The updated time entry response was empty.");

            if (entries is not null)
            {
                var index = entries.FindIndex(entry => entry.Id == updatedEntry.Id);
                if (index >= 0)
                {
                    entries[index] = updatedEntry;
                    entries = entries.OrderBy(entry => entry.Date).ThenBy(entry => entry.Id).ToList();
                }
            }

            isEditModalOpen = false;
            editTarget = null;
        }
        catch (HttpRequestException)
        {
            actionError = "The time entry could not be updated. Please try again.";
        }
        catch (OperationCanceledException)
        {
            actionError = "The time entry could not be updated. Please try again.";
        }
        catch (JsonException)
        {
            actionError = "The server response could not be read. The time entry was not updated.";
        }
        finally
        {
            isUpdating = false;
        }
    }

    private void ClearEditServerValidationForField(object? sender, FieldChangedEventArgs args)
    {
        editServerValidationMessages?.Clear(args.FieldIdentifier);
        editError = null;
        editEditContext?.NotifyValidationStateChanged();
    }

    private void CancelEdit()
    {
        if (!isUpdating)
        {
            isEditModalOpen = false;
            editTarget = null;
            editForm = null;
            editEditContext = null;
            editServerValidationMessages = null;
        }
    }

    private void OpenDeleteModal(TimeEntryResponse entry)
    {
        actionError = null;
        deleteTarget = entry;
        isDeleteModalOpen = true;
    }

    private async Task DeleteEntryAsync()
    {
        if (deleteTarget is null)
        {
            return;
        }

        isDeleting = true;
        actionError = null;

        try
        {
            using var response = await Http.DeleteAsync($"api/time-entries/{deleteTarget.Id}");
            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                actionError = "This time entry no longer exists. Refresh the page and try again.";
                return;
            }

            response.EnsureSuccessStatusCode();
            entries?.RemoveAll(entry => entry.Id == deleteTarget.Id);
            isDeleteModalOpen = false;
            deleteTarget = null;
        }
        catch (HttpRequestException)
        {
            actionError = "The time entry could not be deleted. Please try again.";
        }
        catch (OperationCanceledException)
        {
            actionError = "The time entry could not be deleted. Please try again.";
        }
        finally
        {
            isDeleting = false;
        }
    }

    private void CancelDelete()
    {
        if (!isDeleting)
        {
            isDeleteModalOpen = false;
            deleteTarget = null;
        }
    }

    private void SetupEditContext()
    {
        editContext = new EditContext(form);
        serverValidationMessages = new ValidationMessageStore(editContext);
        editContext.OnFieldChanged += ClearServerValidationForField;
    }

    private void ClearServerValidationForField(object? sender, FieldChangedEventArgs args)
    {
        serverValidationMessages.Clear(args.FieldIdentifier);
        submitError = null;
        editContext.NotifyValidationStateChanged();
    }

    private sealed class TimeEntryForm
    {
        [Required(ErrorMessage = "Date is required.")]
        public DateOnly? Date { get; set; }

        [Required(ErrorMessage = "Project is required.")]
        public string? Project { get; set; }

        [Required(ErrorMessage = "Hours are required.")]
        [Range(typeof(decimal), "0.0000000000000000000000000001", "24",
            ErrorMessage = "Hours must be greater than 0 and no more than 24.")]
        public decimal? Hours { get; set; }

        public string? Description { get; set; }
    }
}
